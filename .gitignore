# Editors and operating systems
.DS_Store
.idea/
# Per-developer git identity, written by `simt init`. Not a file to share:
# it carries whoever is committing into the tree, and a repository has more than
# one of those. See ADR-057.
git.config

.pybuild/
dist/

# Local index, evidence ledger and benchmark run outputs (plan 0003 §4).
# Task descriptors in .simt-dev/bench/tasks/*.json are committed; runs are not.
.simt-dev/index.sqlite
.simt-dev/ledger.jsonl
.simt-dev/bench/runs/
