# Editors and operating systems
.DS_Store
.idea/
# Per-developer git identity, written by `simt init`. Not a file to share:
# it carries whoever is committing into the tree, and a repository has more than
# one of those. See ADR-057.
git.config

.pybuild/
dist/

# Local index, evidence ledger, benchmark run outputs and local-model proposals
# (plan 0003 §4). Task descriptors in .simt-dev/bench/tasks/*.json are committed;
# runs, distilled summaries and review proposals are not.
.simt-dev/index.sqlite
.simt-dev/index.jsonl
.simt-dev/ledger.jsonl
.simt-dev/bench/runs/
.simt-dev/gate/
.simt-dev/distilled/
.simt-dev/reviews/
