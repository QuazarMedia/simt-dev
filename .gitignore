# Editors and operating systems
.DS_Store
.idea/
# Per-developer git identity, written by `simt init`. Not a file to share:
# it carries whoever is committing into the tree, and a repository has more than
# one of those. See ADR-057.
git.config

.pybuild/
dist/
.sea-cache/

# simt-dev runtime state (per-developer; never shared): journal, evidence ledger,
# index cache, benchmark runs, local-model proposals. Nothing in here is committed,
# so ignore the whole directory rather than tracking its ever-growing file list.
.simt/
