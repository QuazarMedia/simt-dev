# Editors and operating systems
.DS_Store
.idea/
# Per-developer git identity, written by `simt init`. Not a file to share:
# it carries whoever is committing into the tree, and a repository has more than
# one of those. See ADR-057.
git.config

.pybuild/
dist/
.sea-cache/

# Local index, evidence ledger, benchmark run outputs and local-model proposals
# (plan 0003 §4). Task descriptors in .simt/bench/tasks/*.json are committed;
# runs, distilled summaries and review proposals are not.
.simt/index.sqlite
.simt/index.jsonl
.simt/ledger.jsonl
.simt/bench/runs/
.simt/gate/
.simt/distilled/
.simt/reviews/

# Write journal for `simt undo`. Local state, never shared.
.simt/journal/

# Gate state for `simt status --line`. Local state, never shared: it names the
# commit the last `check` measured, which is meaningless anywhere else.
.simt/check.json
