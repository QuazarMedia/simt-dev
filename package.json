{
  "name": "simt-dev",
  "version": "0.6.0",
  "description": "An intelligence amplifier for AI coding agents: rules and dual gates adopted by one command, plus local retrieval, task briefs, benches and repo memory — deterministic by default, with local-model adapters that propose and never select.",
  "license": "Apache-2.0",
  "author": "Said Elimam",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuazarMedia/simt-dev"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "simt": "bin/simt.mjs"
  },
  "files": [
    "bin",
    "src",
    "rules",
    "templates",
    "docs/decisions",
    "CHANGELOG.md"
  ],
  "keywords": [
    "agent",
    "agents",
    "ai",
    "codex",
    "cursor",
    "git-hooks",
    "lint",
    "llm",
    "rules",
    "skills"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.mjs",
    "lint": "node bin/simt.mjs doctor"
  }
}
