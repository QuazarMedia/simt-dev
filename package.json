{
  "name": "simt-dev",
  "version": "0.12.0",
  "description": "An intelligence amplifier for AI coding agents: rules and dual gates adopted by one command, plus local retrieval, task briefs, benches and repo memory — deterministic by default, with local-model adapters that propose and never select.",
  "license": "Apache-2.0",
  "author": "Said Elimam",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuazarMedia/simt-dev"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "simt": "bin/simt.mjs"
  },
  "files": [
    "bin",
    "src",
    "rules",
    "templates",
    "agents",
    "skills",
    "ecosystems",
    "harnesses",
    "docs/decisions",
    "docs/guides/local-work.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "agent",
    "agents",
    "ai",
    "codex",
    "cursor",
    "git-hooks",
    "lint",
    "llm",
    "rules",
    "skills"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:coverage": "node scripts/run-tests.mjs unit --coverage",
    "qualify:offline": "node scripts/qualify.mjs offline",
    "qualify:artifacts": "node scripts/qualify.mjs artifacts",
    "qualify:index": "node scripts/bench-index.mjs",
    "lint": "node bin/simt.mjs graph lint",
    "lint:imports": "eslint --fix src packages bin test scripts",
    "verify:shipped": "node --test test/shipped.test.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "verify:wheel": "node scripts/verify-wheel.mjs"
  },
  "exports": {
    ".": "./src/api.mjs",
    "./package.json": "./package.json",
    "./src/brief/assemble.mjs": "./src/brief/assemble.mjs",
    "./src/brief/packet.mjs": "./src/brief/packet.mjs",
    "./src/commands/doc-input.mjs": "./src/commands/doc-input.mjs",
    "./src/commands/skills.mjs": "./src/commands/skills.mjs",
    "./src/graph/compile.mjs": "./src/graph/compile.mjs",
    "./src/graph/load.mjs": "./src/graph/load.mjs",
    "./src/hooks/dispatcher.mjs": "./src/hooks/dispatcher.mjs",
    "./src/index/map.mjs": "./src/index/map.mjs",
    "./src/knowledge/observations.mjs": "./src/knowledge/observations.mjs",
    "./src/measure/ablation.mjs": "./src/measure/ablation.mjs",
    "./src/measure/corpus.mjs": "./src/measure/corpus.mjs",
    "./src/measure/metrics.mjs": "./src/measure/metrics.mjs",
    "./src/measure/records.mjs": "./src/measure/records.mjs",
    "./src/measure/stats.mjs": "./src/measure/stats.mjs",
    "./src/measure/task-schema.mjs": "./src/measure/task-schema.mjs",
    "./src/measure/tasks.mjs": "./src/measure/tasks.mjs",
    "./src/name.mjs": "./src/name.mjs",
    "./src/output/index.mjs": "./src/output/index.mjs",
    "./src/package-version.mjs": "./src/package-version.mjs",
    "./src/plan/index.mjs": "./src/plan/index.mjs",
    "./src/projection/manifest.mjs": "./src/projection/manifest.mjs",
    "./src/projection/markers.mjs": "./src/projection/markers.mjs",
    "./src/projection/mdc.mjs": "./src/projection/mdc.mjs",
    "./src/projection/project.mjs": "./src/projection/project.mjs",
    "./src/projection/rules.mjs": "./src/projection/rules.mjs",
    "./src/projection/surfaces.mjs": "./src/projection/surfaces.mjs",
    "./src/repo-root.mjs": "./src/repo-root.mjs",
    "./src/resolve/fingerprint.mjs": "./src/resolve/fingerprint.mjs",
    "./src/review/critic.mjs": "./src/review/critic.mjs",
    "./src/run.mjs": "./src/run.mjs",
    "./src/state.mjs": "./src/state.mjs",
    "./src/sys/git.mjs": "./src/sys/git.mjs",
    "./src/sys/proc.mjs": "./src/sys/proc.mjs",
    "./src/testing/parsers.mjs": "./src/testing/parsers.mjs",
    "./src/testing/patches.mjs": "./src/testing/patches.mjs",
    "./src/testing/paths.mjs": "./src/testing/paths.mjs",
    "./src/testing/runners.mjs": "./src/testing/runners.mjs",
    "./src/testing/vault.mjs": "./src/testing/vault.mjs",
    "./src/text/tokens.mjs": "./src/text/tokens.mjs",
    "./src/util/canonical.mjs": "./src/util/canonical.mjs",
    "./src/util/sort.mjs": "./src/util/sort.mjs",
    "./src/work/assurance.mjs": "./src/work/assurance.mjs"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-plugin-unused-imports": "^4.4.1"
  },
  "packageManager": "npm@12.0.2"
}
