{
  "schemaVersion": 2,
  "adapters": {
    "claude": {
      "id": "claude",
      "label": "Claude Code",
      "kind": "agent",
      "bin": "claude",
      "prompt": {
        "delivery": "argv",
        "args": ["-p", "{prompt}", "--output-format", "json", "--max-turns", "{turns}"],
        "modelArgs": ["--model", "{model}"]
      },
      "env": { "allow": ["ANTHROPIC_API_KEY"] },
      "isolation": "env",
      "timeoutMs": 120000,
      "usage": {
        "format": "json",
        "fields": {
          "input": ["usage.input_tokens", "usage.input"],
          "cacheWrite": ["usage.cache_creation_input_tokens", "usage.cacheWrite"],
          "cacheRead": ["usage.cache_read_input_tokens", "usage.cacheRead"],
          "output": ["usage.output_tokens", "usage.output"],
          "turns": ["num_turns", "usage.turns"],
          "toolCalls": ["num_tool_calls", "tool_calls", "usage.toolCalls"],
          "costUsd": ["total_cost_usd", "cost_usd", "costUsd"]
        }
      },
      "transcript": { "sources": ["stdout"] }
    },
    "codex": {
      "id": "codex",
      "label": "Codex",
      "kind": "agent",
      "bin": "codex",
      "prompt": {
        "delivery": "argv",
        "args": ["exec", "--json", "{prompt}"],
        "modelArgs": ["--model", "{model}"]
      },
      "env": { "allow": ["OPENAI_API_KEY"] },
      "isolation": "env",
      "timeoutMs": 120000,
      "usage": {
        "format": "jsonl",
        "fields": {
          "input": ["usage.input_tokens", "input_tokens", "usage.input"],
          "cacheWrite": ["usage.cache_creation_input_tokens", "usage.cache_write_input_tokens", "cache_write_input_tokens"],
          "cacheRead": ["usage.cached_input_tokens", "usage.cache_read_input_tokens", "cached_input_tokens"],
          "output": ["usage.output_tokens", "output_tokens", "usage.output"],
          "turns": ["turns", "num_turns"],
          "toolCalls": ["tool_calls", "num_tool_calls"],
          "costUsd": ["total_cost_usd", "cost_usd", "cost"]
        },
        "events": {
          "turns": [{ "type": "turn.completed" }],
          "toolCalls": [
            { "type": "item.completed", "item.type": ["command_execution", "tool_call", "mcp_tool_call"] }
          ]
        }
      },
      "transcript": { "sources": ["stdout"] }
    },
    "gemini": {
      "id": "gemini",
      "label": "Gemini CLI",
      "kind": "agent",
      "bin": "gemini",
      "prompt": {
        "delivery": "argv",
        "args": ["-p", "{prompt}", "--output-format", "json"],
        "modelArgs": ["--model", "{model}"]
      },
      "env": { "allow": ["GEMINI_API_KEY", "GOOGLE_API_KEY"] },
      "isolation": "env",
      "timeoutMs": 120000,
      "usage": {
        "format": "json",
        "fields": {
          "input": ["stats.inputTokens", "stats.tokens.prompt", "stats.prompt_tokens", "usage.input_tokens"],
          "cacheWrite": ["stats.cacheWriteTokens", "stats.tokens.cacheWrite", "usage.cache_creation_input_tokens"],
          "cacheRead": ["stats.cachedTokens", "stats.tokens.cached", "usage.cache_read_input_tokens"],
          "output": ["stats.outputTokens", "stats.tokens.candidates", "stats.completion_tokens", "usage.output_tokens"],
          "turns": ["stats.turns", "stats.totalTurns", "num_turns"],
          "toolCalls": ["stats.toolCalls", "stats.tools.totalCalls", "num_tool_calls"],
          "costUsd": ["stats.totalCostUsd", "stats.costUsd", "total_cost_usd"]
        },
        "totals": [
          {
            "root": "stats.models",
            "keys": { "input": "tokens.prompt", "cacheRead": "tokens.cached", "output": "tokens.candidates" }
          }
        ]
      },
      "transcript": { "sources": ["stdout"] }
    },
    "opencode": {
      "id": "opencode",
      "label": "opencode",
      "kind": "agent",
      "bin": "opencode",
      "prompt": {
        "delivery": "argv",
        "args": ["run", "--format", "json", "{prompt}"],
        "modelArgs": ["--model", "{model}"]
      },
      "env": { "allow": ["OPENAI_API_KEY", "ANTHROPIC_API_KEY"] },
      "isolation": "env",
      "timeoutMs": 120000,
      "usage": {
        "format": "jsonl",
        "fields": {
          "input": ["tokens.input", "usage.input_tokens", "part.tokens.input"],
          "cacheWrite": ["tokens.cache.write", "usage.cache_creation_input_tokens", "part.tokens.cache.write"],
          "cacheRead": ["tokens.cache.read", "usage.cache_read_input_tokens", "part.tokens.cache.read"],
          "output": ["tokens.output", "usage.output_tokens", "part.tokens.output"],
          "turns": ["turns", "num_turns"],
          "toolCalls": ["toolCalls", "num_tool_calls"],
          "costUsd": ["cost", "part.cost", "total_cost_usd"]
        },
        "events": {
          "turns": [{ "type": "step_finish" }, { "event": "message_send" }],
          "toolCalls": [{ "type": "tool_use" }]
        }
      },
      "transcript": { "sources": ["stdout"] }
    },
    "cursor": {
      "id": "cursor",
      "label": "Cursor CLI",
      "kind": "agent",
      "bin": "cursor-agent",
      "prompt": {
        "delivery": "argv",
        "args": ["-p", "{prompt}", "--output-format", "json"],
        "modelArgs": ["--model", "{model}"]
      },
      "env": { "allow": ["CURSOR_API_KEY"] },
      "isolation": "env",
      "timeoutMs": 120000,
      "usage": {
        "format": "json",
        "fields": {
          "input": ["usage.input_tokens", "usage.input", "stats.inputTokens"],
          "cacheWrite": ["usage.cache_creation_input_tokens", "usage.cacheWrite", "stats.cacheWriteTokens"],
          "cacheRead": ["usage.cache_read_input_tokens", "usage.cacheRead", "stats.cachedTokens"],
          "output": ["usage.output_tokens", "usage.output", "stats.outputTokens"],
          "turns": ["num_turns", "turns", "usage.turns"],
          "toolCalls": ["num_tool_calls", "tool_calls", "usage.toolCalls", "toolCalls"],
          "costUsd": ["total_cost_usd", "costUsd", "cost_usd"]
        }
      },
      "transcript": { "sources": ["stdout"] }
    },
    "aider": {
      "id": "aider",
      "label": "Aider",
      "kind": "agent",
      "bin": "aider",
      "prompt": {
        "delivery": "argv",
        "args": ["--message", "{prompt}", "--yes-always", "--analytics-log", "{analyticsLog}"],
        "modelArgs": ["--model", "{model}"]
      },
      "env": { "allow": ["OPENAI_API_KEY", "ANTHROPIC_API_KEY"] },
      "isolation": "env",
      "timeoutMs": 120000,
      "usage": {
        "format": "analytics-log",
        "fields": {
          "input": ["prompt_tokens", "properties.prompt_tokens", "usage.input_tokens"],
          "cacheWrite": ["cache_creation_input_tokens", "properties.cache_write_tokens"],
          "cacheRead": ["cache_read_input_tokens", "properties.cache_read_tokens"],
          "output": ["completion_tokens", "properties.completion_tokens", "usage.output_tokens"],
          "turns": ["turns", "properties.turns"],
          "toolCalls": ["tool_calls", "properties.tool_calls"],
          "costUsd": ["cost", "total_cost", "properties.cost", "properties.total_cost"]
        }
      },
      "transcript": { "sources": ["stdout", "analytics"] }
    },
    "gold": {
      "id": "gold",
      "label": "Gold Oracle",
      "kind": "oracle",
      "oracle": { "from": "vault" },
      "bin": null,
      "prompt": { "delivery": "argv", "args": [], "modelArgs": [] },
      "env": { "allow": [] },
      "isolation": "none",
      "usage": { "format": "none", "fields": {}, "fixed": { "turns": 1, "toolCalls": 1 } },
      "transcript": { "sources": [] }
    },
    "noop": {
      "id": "noop",
      "label": "No-op Baseline",
      "kind": "oracle",
      "oracle": { "from": "none" },
      "bin": null,
      "prompt": { "delivery": "argv", "args": [], "modelArgs": [] },
      "env": { "allow": [] },
      "isolation": "none",
      "usage": { "format": "none", "fields": {} },
      "transcript": { "sources": [] }
    }
  }
}
